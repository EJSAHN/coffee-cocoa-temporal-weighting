{
  "schema_version": "1.0",
  "title": "Supplementary Data S1: municipal production analyses, temporal contrasts and known-truth benchmarks",
  "interpretation": [
    "All empirical estimates are associations or reported-unit descriptive contrasts; causal effects are not identified.",
    "The original panel, common-reference and common-endpoint analyses use different supports and functionals; never pool their numbers as identical estimands.",
    "HAC bandwidth-2 and bandwidth-4 intervals are approximate pointwise model intervals. Real-data coverage is not established and multiplicity is not adjusted.",
    "Simulation results are conditional on three fixed synthetic climate designs. Structural truth, model projection target and descriptive event contrast are distinct quantities.",
    "Temporal L1 norms are exact responses to bounded prescribed perturbations. They do not estimate the bias actually present in the data.",
    "Exact rational weights and numeric-looking identifiers are stored as text. Reported zeros remain numerical zero; unavailable numerical cells remain blank. Explicit source/status symbols remain text."
  ],
  "table_policy": {
    "workbook_cell_budget": 300000,
    "overflow": "Move whole table to indexed CSV.gz companion; never truncate rows or columns.",
    "excluded": "Raw monthly climate and full national production source are not duplicated; input/source manifests identify them. Software logs and nested historical report archives are not scientific data tables."
  },
